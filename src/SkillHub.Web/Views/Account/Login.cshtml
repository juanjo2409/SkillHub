@model SkillHub.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
}

<section aria-labelledby="login-heading" class="max-w-md mx-auto py-4">
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="bg-[#00324D] px-8 py-6 border-b-4 border-[#39A900] text-center">
            <div class="w-12 h-12 rounded-xl bg-[#39A900] text-white font-extrabold flex items-center justify-center mx-auto mb-2 shadow">
                SH
            </div>
            <h1 id="login-heading" class="text-xl font-extrabold text-white">Ingreso a SkillHub</h1>
            <p class="text-xs text-slate-300 mt-1">Accede con tu cuenta de participante</p>
        </div>

        <div class="p-8">
            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 rounded-lg p-3"></div>

                <div>
                    <label asp-for="Email" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                        Correo electrónico
                    </label>
                    <input asp-for="Email" id="loginEmail" type="email" placeholder="jorge.perez@correo.com"
                           class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                    <span asp-validation-for="Email" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                        Contraseña
                    </label>
                    <input asp-for="Password" id="loginPassword" type="password" placeholder="••••••••"
                           class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                    <span asp-validation-for="Password" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <button type="submit"
                        class="w-full py-3 px-4 rounded-lg bg-[#39A900] text-white font-bold text-sm hover:bg-[#2D8600] shadow-xs transition">
                    Iniciar Sesión
                </button>
            </form>

            <div class="mt-6 pt-5 border-t border-slate-100 space-y-2">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2 text-center">Cuentas de prueba pre-cargadas</p>
                <button type="button"
                        onclick="document.getElementById('loginEmail').value='jorge.perez@correo.com'; document.getElementById('loginPassword').value='Skillhub2026*';"
                        class="w-full text-xs font-semibold py-2 px-3 rounded-lg bg-[#EBF7E5] text-[#2D8600] hover:bg-[#39A900] hover:text-white transition">
                    Aprendiz: jorge.perez@correo.com / Skillhub2026*
                </button>
                <button type="button"
                        onclick="document.getElementById('loginEmail').value='andres.mejia@correo.com'; document.getElementById('loginPassword').value='Instructor2026*';"
                        class="w-full text-xs font-semibold py-2 px-3 rounded-lg bg-slate-100 text-[#00324D] hover:bg-[#00324D] hover:text-white transition">
                    Instructor: andres.mejia@correo.com / Instructor2026*
                </button>
            </div>

            <p class="text-center text-xs text-slate-500 mt-6">
                ¿No tienes cuenta?
                <a asp-controller="Account" asp-action="Register" class="font-bold text-[#39A900] hover:underline">
                    Regístrate como participante
                </a>
            </p>
        </div>
    </div>
</section>
