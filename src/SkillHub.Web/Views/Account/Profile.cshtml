@model SkillHub.Web.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Configuración de Perfil";
    var initial = !string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpperInvariant() : "U";
}

<section aria-labelledby="profile-settings-heading" class="max-w-3xl mx-auto space-y-6">
    <div class="bg-[#00324D] rounded-2xl border-b-4 border-[#39A900] p-6 sm:p-8 text-white shadow-xs">
        <div class="flex items-center gap-5">
            <div class="w-14 h-14 rounded-xl bg-[#39A900] text-white text-xl font-extrabold flex items-center justify-center shrink-0">
                @initial
            </div>
            <div>
                <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-0.5 rounded bg-white/15 text-white">
                    @(Model.IsEmployee ? "Instructor / Empleado" : "Participante")
                </span>
                <h1 id="profile-settings-heading" class="text-xl sm:text-2xl font-extrabold text-white mt-1">
                    Configuración de Perfil
                </h1>
                <p class="text-xs sm:text-sm text-slate-300">@Model.Email</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
        <h2 class="text-base font-extrabold text-[#00324D] mb-1">Información Personal</h2>
        <p class="text-xs text-slate-500 mb-6">
            Actualiza tu nombre completo @(Model.IsEmployee ? "y tu especialidad como instructor" : "") o cambia tu contraseña de acceso.
        </p>

        <form asp-controller="Account" asp-action="Profile" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 rounded-lg p-3"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="FullName" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                        Nombre completo
                    </label>
                    <input asp-for="FullName" type="text"
                           class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                    <span asp-validation-for="FullName" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">
                        Correo electrónico (No editable)
                    </label>
                    <input type="email" value="@Model.Email" disabled
                           class="w-full rounded-lg border border-slate-200 bg-slate-100 text-slate-500 px-4 py-2.5 text-sm cursor-not-allowed" />
                </div>
            </div>

            @if (Model.IsEmployee)
            {
                <div>
                    <label asp-for="Specialty" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                        Especialidad del Instructor
                    </label>
                    <input asp-for="Specialty" type="text" placeholder="Ej. Fotografía, Cocina, Oratoria..."
                           class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                    <span asp-validation-for="Specialty" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            }

            <div class="pt-5 border-t border-slate-200">
                <h3 class="text-sm font-extrabold text-[#00324D] mb-1">Cambiar Contraseña (Opcional)</h3>
                <p class="text-xs text-slate-500 mb-4">Deja estos campos en blanco si no deseas modificar tu contraseña actual.</p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="CurrentPassword" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                            Contraseña actual
                        </label>
                        <input asp-for="CurrentPassword" type="password" placeholder="••••••••"
                               class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                    </div>

                    <div>
                        <label asp-for="NewPassword" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                            Nueva contraseña
                        </label>
                        <input asp-for="NewPassword" type="password" placeholder="Mínimo 6 caracteres y un número"
                               class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                        <span asp-validation-for="NewPassword" class="text-xs text-rose-600 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="pt-4 flex items-center justify-end gap-3">
                <a asp-controller="Workshops" asp-action="Index"
                   class="text-xs font-bold px-4 py-2.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 transition">
                    Cancelar
                </a>
                <button type="submit"
                        class="text-xs font-bold px-6 py-2.5 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] shadow-xs transition">
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</section>
