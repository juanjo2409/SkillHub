@model SkillHub.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registro de Participante";
}

<section aria-labelledby="register-heading" class="max-w-md mx-auto py-4">
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="bg-[#00324D] px-8 py-6 border-b-4 border-[#39A900] text-center">
            <div class="w-12 h-12 rounded-xl bg-[#39A900] text-white font-extrabold flex items-center justify-center mx-auto mb-2 shadow">
                SH
            </div>
            <h1 id="register-heading" class="text-xl font-extrabold text-white">Registro de Participante</h1>
            <p class="text-xs text-slate-300 mt-1">Crea tu cuenta para inscribirte en los talleres de SkillHub</p>
        </div>

        <div class="p-8">
            <form asp-controller="Account" asp-action="Register" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 rounded-lg p-3"></div>

                <div>
                    <label asp-for="FullName" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                        Nombre completo
                    </label>
                    <input asp-for="FullName" type="text" placeholder="Ej. Valentina Gómez Ruiz"
                           class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                    <span asp-validation-for="FullName" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Email" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                        Correo electrónico
                    </label>
                    <input asp-for="Email" type="email" placeholder="tu.correo@ejemplo.com"
                           class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                    <span asp-validation-for="Email" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-xs font-bold uppercase tracking-wider text-[#00324D] mb-1.5">
                        Contraseña
                    </label>
                    <input asp-for="Password" type="password" placeholder="Mínimo 6 caracteres y un número"
                           class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-[#39A900] focus:outline-none" />
                    <span asp-validation-for="Password" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <button type="submit"
                        class="w-full py-3 px-4 rounded-lg bg-[#39A900] text-white font-bold text-sm hover:bg-[#2D8600] shadow-xs transition">
                    Crear Cuenta
                </button>
            </form>

            <p class="text-center text-xs text-slate-500 mt-6">
                ¿Ya tienes cuenta registrada?
                <a asp-controller="Account" asp-action="Login" class="font-bold text-[#39A900] hover:underline">
                    Ingresa aquí
                </a>
            </p>
        </div>
    </div>
</section>
