@model IReadOnlyList<SkillHub.Application.DTOs.Enrollments.EnrollmentResponseDto>
@{
    ViewData["Title"] = "Mis Inscripciones";
    var activeCount = Model.Count(e => e.Status == "Active");
    var cancelledCount = Model.Count(e => e.Status != "Active");
}

<section aria-labelledby="my-enrollments-heading">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 mb-6 border-b border-slate-200">
        <div>
            <h1 id="my-enrollments-heading" class="text-2xl sm:text-3xl font-extrabold text-[#00324D]">Mis inscripciones</h1>
            <p class="text-sm text-slate-500 mt-1">
                Activas: <strong>@activeCount</strong> • Canceladas: <strong>@cancelledCount</strong>
            </p>
        </div>
        <a asp-controller="Workshops" asp-action="Index"
           class="inline-flex items-center justify-center text-xs sm:text-sm font-bold px-4 py-2.5 rounded-xl bg-[#00324D] text-white hover:bg-[#002235] transition">
            Explorar talleres
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
            <p class="text-base font-bold text-[#00324D] mb-1">Aún no tienes inscripciones registradas</p>
            <p class="text-xs text-slate-500 mb-5">Selecciona un taller del catálogo para inscribirte y descargar tu constancia PDF.</p>
            <a asp-controller="Workshops" asp-action="Index"
               class="inline-block text-xs font-bold px-5 py-2.5 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] transition">
                Ver talleres disponibles
            </a>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var enrollment in Model)
            {
                var isActive = enrollment.Status == "Active";

                <article class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                    <div class="space-y-2">
                        <div class="flex flex-wrap items-center gap-2.5">
                            <span class="text-xs font-mono font-bold px-2.5 py-1 rounded bg-slate-100 text-[#00324D]">
                                @enrollment.WorkshopCode
                            </span>

                            @if (isActive)
                            {
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-[#EBF7E5] text-[#2D8600]">
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-slate-100 text-slate-500">
                                    Cancelada
                                </span>
                            }

                            <span class="text-xs text-slate-400">
                                Inscrito el @enrollment.EnrollmentDate.ToString("yyyy-MM-dd HH:mm") UTC
                            </span>
                        </div>

                        <h2 class="text-lg font-bold text-[#00324D]">@enrollment.WorkshopTitle</h2>

                        <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-600">
                            <span><strong>Instructor:</strong> @enrollment.InstructorName</span>
                            <span><strong>Fecha:</strong> @enrollment.StartDate.ToString("yyyy-MM-dd")</span>
                            <span><strong>Horario:</strong> @enrollment.StartDate.ToString("HH:mm") – @enrollment.EndDate.ToString("HH:mm") UTC</span>
                        </div>

                        @if (!isActive && enrollment.CancelledAt.HasValue)
                        {
                            <p class="text-xs font-medium text-rose-600">
                                Cancelada el @enrollment.CancelledAt.Value.ToString("yyyy-MM-dd HH:mm") UTC
                            </p>
                        }
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5 shrink-0">
                        @if (isActive)
                        {
                            <a asp-controller="Enrollments" asp-action="Certificate" asp-route-id="@enrollment.Id"
                               class="inline-flex items-center gap-2 text-xs font-bold px-4 py-2.5 rounded-lg bg-[#00324D] text-white hover:bg-[#002235] transition">
                                <span>⬇ Constancia PDF</span>
                            </a>

                            <form id="cancel-form-@enrollment.Id" asp-controller="Enrollments" asp-action="Cancel" asp-route-id="@enrollment.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        onclick="confirmCancellation('@enrollment.Id', '@enrollment.WorkshopCode — @enrollment.WorkshopTitle')"
                                        class="text-xs font-bold px-4 py-2.5 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 transition">
                                    Cancelar inscripción
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Workshops" asp-action="Details" asp-route-id="@enrollment.WorkshopId"
                               class="text-xs font-bold px-4 py-2.5 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] transition">
                                Volver a inscribirme
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
        function confirmCancellation(enrollmentId, workshopLabel) {
            Swal.fire({
                title: '¿Cancelar inscripción?',
                html: `Se liberará tu cupo en <strong>${workshopLabel}</strong>.<br/><span class="text-xs text-slate-500">Recuerda que puedes cancelar hasta 24 horas antes del inicio del taller.</span>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#E11D48',
                cancelButtonColor: '#00324D',
                confirmButtonText: 'Sí, cancelar cupo',
                cancelButtonText: 'Conservar inscripción'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('cancel-form-' + enrollmentId)?.submit();
                }
            });
        }
    </script>
}
