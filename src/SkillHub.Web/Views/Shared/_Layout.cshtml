<!DOCTYPE html>
<html lang="es" class="h-full bg-[#F4F7F9]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkillHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Work Sans', sans-serif; }
    </style>
</head>
<body class="min-h-full flex flex-col text-slate-800 antialiased">

    <header class="sticky top-0 z-50 bg-[#00324D] text-white border-b-2 border-[#39A900]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-8">
                    <a asp-controller="Workshops" asp-action="Index" class="flex items-center gap-2.5">
                        <span class="w-9 h-9 rounded-lg bg-[#39A900] text-white font-bold text-sm flex items-center justify-center">
                            SH
                        </span>
                        <span class="text-xl font-bold tracking-tight text-white">SkillHub</span>
                    </a>

                    <nav class="hidden md:flex items-center gap-1">
                        <a asp-controller="Workshops" asp-action="Index"
                           class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-100 hover:bg-white/10 transition">
                            Talleres
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Employee"))
                            {
                                <a asp-controller="Account" asp-action="Students"
                                   class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-100 hover:bg-white/10 transition">
                                    Ver estudiantes
                                </a>
                            }
                            @if (User.IsInRole("Participant"))
                            {
                                <a asp-controller="Enrollments" asp-action="Mine"
                                   class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-100 hover:bg-white/10 transition">
                                    Mis inscripciones
                                </a>
                            }
                            <a asp-controller="Account" asp-action="Profile"
                               class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-100 hover:bg-white/10 transition">
                                Perfil
                            </a>
                        }
                    </nav>
                </div>

                <div class="flex items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var userName = User.Identity.Name ?? "Usuario";

                        <a asp-controller="Account" asp-action="Profile"
                           class="hidden sm:inline-block text-sm text-slate-200 hover:text-white transition truncate max-w-[200px]">
                            @userName
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="text-xs font-semibold px-3.5 py-2 rounded-lg bg-white/10 text-white hover:bg-white/20 transition">
                                Salir
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="text-sm font-medium px-3.5 py-2 rounded-lg text-white hover:bg-white/10 transition">
                            Ingresar
                        </a>
                        <a asp-controller="Account" asp-action="Register"
                           class="text-sm font-semibold px-4 py-2 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] transition">
                            Registrarse
                        </a>
                    }
                </div>
            </div>

            <nav class="flex md:hidden items-center gap-2 pb-3 pt-1 border-t border-white/10 overflow-x-auto">
                <a asp-controller="Workshops" asp-action="Index"
                   class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-white/10">
                    Talleres
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Employee"))
                    {
                        <a asp-controller="Account" asp-action="Students"
                           class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-white/10">
                            Ver estudiantes
                        </a>
                    }
                    @if (User.IsInRole("Participant"))
                    {
                        <a asp-controller="Enrollments" asp-action="Mine"
                           class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-white/10">
                            Mis inscripciones
                        </a>
                    }
                    <a asp-controller="Account" asp-action="Profile"
                       class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-white/10">
                        Perfil
                    </a>
                }
            </nav>
        </div>
    </header>

    <main role="main" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div role="alert" class="mb-6 rounded-xl bg-[#EBF7E5] border-l-4 border-[#39A900] p-4 flex items-center justify-between text-[#00324D]">
                <p class="text-sm font-semibold">@successMsg</p>
                <button type="button" onclick="this.parentElement.remove()" class="text-[#00324D] hover:opacity-70 p-1 text-sm font-bold">✕</button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div role="alert" class="mb-6 rounded-xl bg-rose-50 border-l-4 border-rose-600 p-4 flex items-center justify-between text-rose-900">
                <p class="text-sm font-semibold">@errorMsg</p>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-700 hover:opacity-70 p-1 text-sm font-bold">✕</button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="bg-[#00324D] text-slate-300 border-t-4 border-[#39A900] mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-8 border-b border-white/10">
                <div class="md:col-span-5 space-y-3">
                    <div class="flex items-center gap-2.5">
                        <span class="w-8 h-8 rounded-lg bg-[#39A900] text-white text-xs font-bold flex items-center justify-center">
                            SH
                        </span>
                        <span class="text-lg font-bold text-white tracking-tight">SkillHub</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed max-w-sm">
                        Plataforma para la programación de talleres cortos presenciales, consulta de cupos en tiempo real, gestión de inscripciones y descarga de certificados en PDF.
                    </p>
                </div>

                <div class="md:col-span-3 space-y-2.5">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-white">Navegación</h3>
                    <ul class="space-y-2 text-xs text-slate-300">
                        <li>
                            <a asp-controller="Workshops" asp-action="Index" class="hover:text-[#8CE558] transition">
                                Talleres disponibles
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Participant"))
                            {
                                <li>
                                    <a asp-controller="Enrollments" asp-action="Mine" class="hover:text-[#8CE558] transition">
                                        Mis inscripciones
                                    </a>
                                </li>
                            }
                            <li>
                                <a asp-controller="Account" asp-action="Profile" class="hover:text-[#8CE558] transition">
                                    Mi perfil
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a asp-controller="Account" asp-action="Login" class="hover:text-[#8CE558] transition">
                                    Iniciar sesión
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Account" asp-action="Register" class="hover:text-[#8CE558] transition">
                                    Crear cuenta de participante
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="md:col-span-4 space-y-2.5">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-white">Áreas de talleres</h3>
                    <div class="flex flex-wrap gap-1.5 text-xs">
                        <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">Fotografía</span>
                        <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">Cocina</span>
                        <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">Oratoria</span>
                        <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">Diseño gráfico</span>
                        <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">Música</span>
                        <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">Marketing digital</span>
                    </div>
                </div>
            </div>

            <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
                <p>&copy; @DateTime.UtcNow.Year SkillHub. Todos los derechos reservados.</p>
                <p>Centro de formación presencial</p>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
