<!DOCTYPE html>
<html lang="es" class="h-full bg-[#F4F7F9]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkillHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Work Sans', sans-serif; }
    </style>
</head>
<body class="min-h-full flex flex-col text-slate-800 antialiased">

    <header class="sticky top-0 z-50 bg-[#00324D] text-white border-b-2 border-[#39A900]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-8">
                    <a asp-controller="Workshops" asp-action="Index" class="flex items-center gap-2.5">
                        <span class="w-9 h-9 rounded-lg bg-[#39A900] text-white font-bold text-sm flex items-center justify-center">
                            SH
                        </span>
                        <span class="text-xl font-bold tracking-tight text-white">SkillHub</span>
                    </a>

                    <nav class="hidden md:flex items-center gap-1">
                        <a asp-controller="Workshops" asp-action="Index"
                           class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-100 hover:bg-white/10 transition">
                            Talleres
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Participant"))
                            {
                                <a asp-controller="Enrollments" asp-action="Mine"
                                   class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-100 hover:bg-white/10 transition">
                                    Mis inscripciones
                                </a>
                            }
                            <a asp-controller="Account" asp-action="Profile"
                               class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-100 hover:bg-white/10 transition">
                                Perfil
                            </a>
                        }
                    </nav>
                </div>

                <div class="flex items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var userName = User.Identity.Name ?? "Usuario";

                        <a asp-controller="Account" asp-action="Profile"
                           class="hidden sm:inline-block text-sm text-slate-200 hover:text-white transition truncate max-w-[200px]">
                            @userName
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="text-xs font-semibold px-3.5 py-2 rounded-lg bg-white/10 text-white hover:bg-white/20 transition">
                                Salir
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="text-sm font-medium px-3.5 py-2 rounded-lg text-white hover:bg-white/10 transition">
                            Ingresar
                        </a>
                        <a asp-controller="Account" asp-action="Register"
                           class="text-sm font-semibold px-4 py-2 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] transition">
                            Registrarse
                        </a>
                    }
                </div>
            </div>

            <nav class="flex md:hidden items-center gap-2 pb-3 pt-1 border-t border-white/10 overflow-x-auto">
                <a asp-controller="Workshops" asp-action="Index"
                   class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-white/10">
                    Talleres
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Participant"))
                    {
                        <a asp-controller="Enrollments" asp-action="Mine"
                           class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-white/10">
                            Mis inscripciones
                        </a>
                    }
                    <a asp-controller="Account" asp-action="Profile"
                       class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-white/10">
                        Perfil
                    </a>
                }
            </nav>
        </div>
    </header>

    <main role="main" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div role="alert" class="mb-6 rounded-xl bg-[#EBF7E5] border-l-4 border-[#39A900] p-4 flex items-center justify-between text-[#00324D]">
                <p class="text-sm font-semibold">@successMsg</p>
                <button type="button" onclick="this.parentElement.remove()" class="text-[#00324D] hover:opacity-70 p-1 text-sm font-bold">✕</button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div role="alert" class="mb-6 rounded-xl bg-rose-50 border-l-4 border-rose-600 p-4 flex items-center justify-between text-rose-900">
                <p class="text-sm font-semibold">@errorMsg</p>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-700 hover:opacity-70 p-1 text-sm font-bold">✕</button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="bg-[#00324D] text-slate-300 border-t-2 border-[#39A900] mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
            <p class="font-medium text-white">SkillHub — Gestión de talleres e inscripciones</p>
            <p class="text-slate-400">&copy; @DateTime.UtcNow.Year SkillHub</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
