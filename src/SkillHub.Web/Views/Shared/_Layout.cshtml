<!DOCTYPE html>
<html lang="es" class="h-full scroll-smooth bg-[#F4F7F9]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SkillHub Betowa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sena: {
                            green: '#39A900',
                            greenDark: '#2D8600',
                            greenLight: '#EBF7E5',
                            navy: '#00324D',
                            navyDark: '#002235',
                            teal: '#005A64',
                            orange: '#FF6B00'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Work Sans', sans-serif; }
    </style>
</head>
<body class="min-h-full flex flex-col text-slate-800 antialiased selection:bg-[#39A900] selection:text-white">

    <!-- Top Institutional Bar (Betowa Navy) -->
    <div class="bg-[#002235] text-white/90 text-xs py-1.5 border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#39A900]"></span>
                <span class="font-medium tracking-wide">PORTAL DE OFERTA EDUCATIVA Y TALLERES PRESENCIALES</span>
            </div>
            <span class="hidden sm:inline text-white/70">Formación Continua • Certificación Oficial en PDF</span>
        </div>
    </div>

    <!-- Main Betowa Header -->
    <header class="sticky top-0 z-50 bg-[#00324D] text-white shadow-md border-b-4 border-[#39A900]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <div class="flex items-center gap-10">
                    <a asp-controller="Workshops" asp-action="Index" class="flex items-center gap-3.5 group">
                        <div class="w-11 h-11 rounded-xl bg-[#39A900] text-white flex items-center justify-center shadow-md group-hover:bg-[#2D8600] transition">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                            </svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-2xl font-extrabold tracking-tight text-white">SkillHub</span>
                                <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#39A900] text-white">
                                    Formación
                                </span>
                            </div>
                            <p class="text-xs text-slate-300 hidden sm:block">Inspirado en el ecosistema educativo Betowa</p>
                        </div>
                    </a>

                    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-2">
                        <a asp-controller="Workshops" asp-action="Index"
                           class="px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-white/10 transition">
                            Oferta de Talleres
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Participant"))
                            {
                                <a asp-controller="Enrollments" asp-action="Mine"
                                   class="px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-white/10 transition flex items-center gap-2">
                                    <span>Mis Inscripciones</span>
                                    <span class="w-2 h-2 rounded-full bg-[#39A900]"></span>
                                </a>
                            }
                            <a asp-controller="Account" asp-action="Profile"
                               class="px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-white/10 transition">
                                Mi Perfil
                            </a>
                        }
                    </nav>
                </div>

                <div class="flex items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var userName = User.Identity.Name ?? "Aprendiz";
                        var initial = userName.Length > 0 ? userName.Substring(0, 1).ToUpperInvariant() : "A";

                        <a asp-controller="Account" asp-action="Profile"
                           class="hidden sm:flex items-center gap-3 pl-2 pr-3.5 py-1.5 rounded-xl bg-white/10 border border-white/15 hover:bg-white/20 transition">
                            <div class="w-8 h-8 rounded-lg bg-[#39A900] text-white font-bold text-xs flex items-center justify-center">
                                @initial
                            </div>
                            <div class="text-left leading-tight">
                                <p class="text-xs font-bold text-white truncate max-w-[150px]">@userName</p>
                                <p class="text-[11px] font-medium text-[#8CE558]">
                                    @(User.IsInRole("Employee") ? "Mi Perfil (Instructor)" : "Mi Perfil (Aprendiz)")
                                </p>
                            </div>
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="text-xs sm:text-sm font-semibold px-4 py-2 rounded-lg bg-white/10 border border-white/20 text-white hover:bg-rose-600 hover:border-rose-600 transition">
                                Cerrar sesión
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="text-sm font-semibold px-4 py-2 rounded-lg text-white hover:bg-white/10 border border-white/20 transition">
                            Ingresar
                        </a>
                        <a asp-controller="Account" asp-action="Register"
                           class="text-sm font-bold px-5 py-2.5 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] shadow-sm transition">
                            Registrarse
                        </a>
                    }
                </div>
            </div>

            <!-- Mobile Responsive Navigation Bar -->
            <nav aria-label="Navegación móvil" class="flex md:hidden items-center gap-2 pb-3 pt-1 border-t border-white/10 overflow-x-auto">
                <a asp-controller="Workshops" asp-action="Index"
                   class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-white/10 hover:bg-white/20 transition">
                    Oferta de Talleres
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Participant"))
                    {
                        <a asp-controller="Enrollments" asp-action="Mine"
                           class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-white/10 hover:bg-white/20 transition flex items-center gap-1.5">
                            <span>Mis Inscripciones</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#39A900]"></span>
                        </a>
                    }
                    <a asp-controller="Account" asp-action="Profile"
                       class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-white/10 hover:bg-white/20 transition">
                        Mi Perfil
                    </a>
                }
            </nav>
        </div>
    </header>

    <main role="main" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div role="alert" class="mb-8 rounded-xl bg-[#EBF7E5] border-l-4 border-[#39A900] p-4 flex items-center justify-between text-[#00324D] shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-8 h-8 rounded-lg bg-[#39A900] text-white flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-[#2D8600]">Proceso Exitoso</p>
                        <p class="text-sm font-semibold">@successMsg</p>
                    </div>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-[#00324D] hover:opacity-70 p-1 text-sm font-bold">✕</button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div role="alert" class="mb-8 rounded-xl bg-rose-50 border-l-4 border-rose-600 p-4 flex items-center justify-between text-rose-900 shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-8 h-8 rounded-lg bg-rose-600 text-white flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-rose-700">Validación de Regla de Negocio</p>
                        <p class="text-sm font-semibold">@errorMsg</p>
                    </div>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-700 hover:opacity-70 p-1 text-sm font-bold">✕</button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Betowa Navy & SENA Green Footer -->
    <footer class="bg-[#00324D] text-slate-300 border-t-4 border-[#39A900] mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-white/10">
                <div>
                    <div class="flex items-center gap-2.5 mb-3">
                        <span class="w-8 h-8 rounded-lg bg-[#39A900] text-white text-xs font-extrabold flex items-center justify-center">SH</span>
                        <span class="text-base font-bold text-white">SkillHub Centro de Formación</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        Plataforma de inscripción y control de talleres cortos presenciales con verificación automática de cupos, horarios y descarga de constancia oficial en PDF.
                    </p>
                </div>

                <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-[#8CE558] mb-3">Áreas Tecnológicas y Creativas</h3>
                    <div class="flex flex-wrap gap-2 text-xs">
                        <span class="px-2.5 py-1 rounded bg-white/10 text-white">Fotografía</span>
                        <span class="px-2.5 py-1 rounded bg-white/10 text-white">Cocina</span>
                        <span class="px-2.5 py-1 rounded bg-white/10 text-white">Oratoria</span>
                        <span class="px-2.5 py-1 rounded bg-white/10 text-white">Diseño Gráfico</span>
                        <span class="px-2.5 py-1 rounded bg-white/10 text-white">Música</span>
                        <span class="px-2.5 py-1 rounded bg-white/10 text-white">Marketing Digital</span>
                    </div>
                </div>

                <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-[#8CE558] mb-3">Lineamientos de Matrícula</h3>
                    <ul class="space-y-1.5 text-xs text-slate-300">
                        <li>• Control estricto de cupos disponibles por taller.</li>
                        <li>• Validación automática contra cruces de horario.</li>
                        <li>• Cancelación habilitada hasta 24h antes del inicio.</li>
                        <li>• Emisión inmediata de constancia activa en PDF.</li>
                    </ul>
                </div>
            </div>

            <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
                <p>&copy; @DateTime.UtcNow.Year SkillHub — Diseño inspirado en Betowa. Todos los derechos reservados.</p>
                <p class="text-[#8CE558] font-semibold">Educación Práctica y Presencial</p>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
