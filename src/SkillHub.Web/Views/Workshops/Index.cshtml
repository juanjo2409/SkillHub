@using System.Globalization
@model SkillHub.Web.Models.WorkshopCatalogViewModel
@{
    ViewData["Title"] = "Talleres";
    var esCulture = new CultureInfo("es-CO");
    var specialties = Model.Workshops
        .Select(w => w.InstructorSpecialty)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .OrderBy(s => s)
        .ToList();
}

<!-- Clean Editorial Page Header + Search & Category Filter Bar -->
<section class="mb-8 space-y-5">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-slate-200">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#00324D] tracking-tight">
                Catálogo de talleres presenciales
            </h1>
            <p class="text-sm text-slate-500 mt-1">
                Explora la programación vigente, revisa los horarios y asegura tu cupo en línea.
            </p>
        </div>

        <div class="relative w-full md:w-80">
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input id="workshopSearch" type="search"
                   placeholder="Buscar por taller, código o instructor..."
                   oninput="filterWorkshops()"
                   class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-800 text-xs sm:text-sm placeholder:text-slate-400 focus:border-[#00324D] focus:outline-none transition" />
        </div>
    </div>

    <div class="flex items-center gap-2 overflow-x-auto pb-1">
        <button type="button" onclick="setSpecialtyFilter('ALL', this)"
                class="specialty-pill shrink-0 text-xs font-bold px-4 py-2 rounded-lg bg-[#00324D] text-white transition">
            Todos (@Model.Workshops.Count)
        </button>
        @foreach (var spec in specialties)
        {
            <button type="button" onclick="setSpecialtyFilter('@spec', this)"
                    class="specialty-pill shrink-0 text-xs font-semibold px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 hover:border-[#00324D] hover:text-[#00324D] transition">
                @spec
            </button>
        }
    </div>
</section>

<!-- Bespoke Workshop Cards Grid -->
<section aria-label="Listado de talleres disponibles">
    @if (Model.Workshops.Count == 0)
    {
        <div class="rounded-2xl bg-white border border-slate-200 p-12 text-center">
            <p class="text-base font-bold text-[#00324D] mb-1">No hay talleres futuros programados</p>
            <p class="text-xs text-slate-500">Pronto se publicarán nuevas fechas.</p>
        </div>
    }
    else
    {
        <div id="workshopsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var workshop in Model.Workshops)
            {
                var isEnrolled = Model.ActiveEnrolledWorkshopIds.Contains(workshop.Id);
                var hasSpots = workshop.AvailableSpots > 0;
                var dayNumber = workshop.StartDate.ToString("dd");
                var monthShort = workshop.StartDate.ToString("MMM", esCulture).TrimEnd('.').ToUpperInvariant();
                var instructorInitial = !string.IsNullOrEmpty(workshop.InstructorName)
                    ? workshop.InstructorName.Substring(0, 1).ToUpperInvariant()
                    : "I";

                <article data-specialty="@workshop.InstructorSpecialty"
                         data-search="@($"{workshop.Code} {workshop.Title} {workshop.Description} {workshop.InstructorName} {workshop.InstructorSpecialty}".ToLowerInvariant())"
                         class="workshop-card group bg-white rounded-2xl border border-slate-200/90 hover:border-[#00324D]/40 hover:shadow-md transition-all duration-200 flex flex-col justify-between p-6">

                    <div>
                        <!-- Top Row: Calendar Date Block + Category & Code -->
                        <div class="flex items-start justify-between gap-4 mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex flex-col items-center justify-center leading-none shrink-0">
                                    <span class="text-sm font-extrabold text-[#00324D]">@dayNumber</span>
                                    <span class="text-[10px] font-bold text-slate-500 mt-0.5">@monthShort</span>
                                </div>
                                <div>
                                    <span class="text-[11px] font-bold uppercase tracking-wider text-[#2D8600]">
                                        @workshop.InstructorSpecialty
                                    </span>
                                    <p class="text-xs font-medium text-slate-500 mt-0.5">
                                        @workshop.StartDate.ToString("HH:mm") – @workshop.EndDate.ToString("HH:mm") UTC
                                    </p>
                                </div>
                            </div>

                            <div class="flex flex-col items-end gap-1">
                                <span class="text-[11px] font-mono font-bold px-2.5 py-1 rounded-md bg-slate-100 text-slate-700">
                                    @workshop.Code
                                </span>
                                @if (isEnrolled)
                                {
                                    <span class="text-[11px] font-bold text-[#2D8600]">
                                        ✓ Inscrito
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Workshop Title & Description -->
                        <h2 class="text-lg font-bold text-[#00324D] group-hover:text-[#39A900] transition mb-1.5 line-clamp-1">
                            <a asp-controller="Workshops" asp-action="Details" asp-route-id="@workshop.Id">
                                @workshop.Title
                            </a>
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-5 line-clamp-2">
                            @workshop.Description
                        </p>

                        <!-- Instructor Row -->
                        <div class="flex items-center gap-2.5 pt-4 border-t border-slate-100 mb-5">
                            <div class="w-7 h-7 rounded-full bg-[#00324D] text-white text-xs font-bold flex items-center justify-center shrink-0">
                                @instructorInitial
                            </div>
                            <div class="truncate">
                                <p class="text-xs font-semibold text-slate-800 truncate">@workshop.InstructorName</p>
                            </div>
                        </div>
                    </div>

                    <!-- Card Footer: Spots Badge + Action -->
                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full @(hasSpots ? "bg-[#39A900]" : "bg-rose-500")"></span>
                            <span class="text-xs font-semibold @(hasSpots ? "text-slate-700" : "text-rose-600")">
                                @(hasSpots ? $"{workshop.AvailableSpots} de {workshop.MaxCapacity} cupos" : "Sin cupos")
                            </span>
                        </div>

                        <div class="flex items-center gap-2">
                            <a asp-controller="Workshops" asp-action="Details" asp-route-id="@workshop.Id"
                               class="text-xs font-semibold px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-[#00324D] transition">
                                Detalles
                            </a>

                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Participant"))
                            {
                                @if (isEnrolled)
                                {
                                    <a asp-controller="Enrollments" asp-action="Mine"
                                       class="text-xs font-bold px-3.5 py-2 rounded-lg bg-slate-100 text-[#00324D] hover:bg-slate-200 transition">
                                        Ver cupo
                                    </a>
                                }
                                else if (hasSpots)
                                {
                                    <form id="enroll-form-@workshop.Id" asp-controller="Enrollments" asp-action="Create" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="workshopId" value="@workshop.Id" />
                                        <button type="button"
                                                onclick="confirmEnrollment('@workshop.Id', '@workshop.Title', '@workshop.StartDate.ToString("yyyy-MM-dd HH:mm") UTC')"
                                                class="text-xs font-bold px-4 py-2 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] transition">
                                            Inscribirme
                                        </button>
                                    </form>
                                }
                            }
                            else if (User.Identity?.IsAuthenticated != true && hasSpots)
                            {
                                <a asp-controller="Account" asp-action="Login"
                                   class="text-xs font-bold px-4 py-2 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] transition">
                                    Inscribirme
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <div id="noSearchResults" class="hidden rounded-2xl bg-white border border-slate-200 p-12 text-center mt-4">
            <p class="text-base font-bold text-[#00324D] mb-1">No se encontraron talleres con ese criterio</p>
            <p class="text-xs text-slate-500 mb-4">Prueba con otra palabra clave o muestra todas las áreas.</p>
            <button type="button" onclick="resetWorkshopFilters()"
                    class="text-xs font-bold px-4 py-2 rounded-lg bg-[#00324D] text-white hover:bg-[#002235] transition">
                Mostrar todos los talleres
            </button>
        </div>
    }
</section>

@section Scripts {
    <script>
        let currentSpecialty = 'ALL';

        function setSpecialtyFilter(specialty, btn) {
            currentSpecialty = specialty;
            document.querySelectorAll('.specialty-pill').forEach(el => {
                el.className = 'specialty-pill shrink-0 text-xs font-semibold px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 hover:border-[#00324D] hover:text-[#00324D] transition';
            });
            btn.className = 'specialty-pill shrink-0 text-xs font-bold px-4 py-2 rounded-lg bg-[#00324D] text-white transition';
            filterWorkshops();
        }

        function filterWorkshops() {
            const query = (document.getElementById('workshopSearch')?.value || '').toLowerCase().trim();
            let visibleCount = 0;

            document.querySelectorAll('.workshop-card').forEach(card => {
                const spec = card.getAttribute('data-specialty') || '';
                const text = card.getAttribute('data-search') || '';
                const matchesSpec = currentSpecialty === 'ALL' || spec === currentSpecialty;
                const matchesText = !query || text.includes(query);
                const isVisible = matchesSpec && matchesText;
                card.style.display = isVisible ? '' : 'none';
                if (isVisible) visibleCount++;
            });

            const emptyState = document.getElementById('noSearchResults');
            if (emptyState) {
                emptyState.classList.toggle('hidden', visibleCount > 0);
            }
        }

        function resetWorkshopFilters() {
            const searchInput = document.getElementById('workshopSearch');
            if (searchInput) searchInput.value = '';
            const firstPill = document.querySelector('.specialty-pill');
            if (firstPill) setSpecialtyFilter('ALL', firstPill);
        }

        function confirmEnrollment(workshopId, title, dateLabel) {
            Swal.fire({
                title: '¿Confirmar inscripción?',
                html: `Te inscribirás en el taller <strong>${title}</strong> programado para el <strong>${dateLabel}</strong>.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#39A900',
                cancelButtonColor: '#64748B',
                confirmButtonText: 'Sí, inscribirme',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('enroll-form-' + workshopId)?.submit();
                }
            });
        }
    </script>
}
