@model SkillHub.Web.Models.WorkshopCatalogViewModel
@{
    ViewData["Title"] = "Oferta de Talleres";
    var totalSpots = Model.Workshops.Sum(w => w.AvailableSpots);
    var specialties = Model.Workshops
        .Select(w => w.InstructorSpecialty)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .OrderBy(s => s)
        .ToList();
}

<!-- Betowa-style Hero Banner -->
<section aria-labelledby="hero-heading" class="mb-8">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#00324D] via-[#004266] to-[#005A64] text-white p-8 sm:p-10 shadow-lg border-b-4 border-[#39A900]">
        <div class="relative z-10 max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#39A900] text-white text-xs font-bold uppercase tracking-wider mb-4">
                <span>Convocatoria Presencial Abierta</span>
            </div>
            <h1 id="hero-heading" class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight mb-3">
                 ¿Qué quieres aprender hoy en SkillHub?
            </h1>
            <p class="text-slate-200 text-sm sm:text-base leading-relaxed mb-6 max-w-2xl">
                Consulta nuestra oferta de talleres cortos presenciales, verifica los cupos disponibles en tiempo real e inscríbete de forma gratuita.
            </p>

            <!-- Search Input inside Hero like Betowa -->
            <div class="relative max-w-xl">
                <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input id="workshopSearch" type="search"
                       placeholder="Busca por nombre del taller, código (FOT-001) o área..."
                       oninput="filterWorkshops()"
                       class="w-full pl-12 pr-4 py-3.5 rounded-xl bg-white text-slate-900 text-sm font-medium placeholder:text-slate-400 shadow-md focus:ring-2 focus:ring-[#39A900] focus:outline-none" />
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-white/15">
            <div>
                <p class="text-2xl font-extrabold text-[#8CE558]">@Model.Workshops.Count</p>
                <p class="text-xs font-medium text-slate-200">Talleres Disponibles</p>
            </div>
            <div>
                <p class="text-2xl font-extrabold text-white">@totalSpots</p>
                <p class="text-xs font-medium text-slate-200">Cupos Totales Libres</p>
            </div>
            <div>
                <p class="text-2xl font-extrabold text-[#8CE558]">@specialties.Count</p>
                <p class="text-xs font-medium text-slate-200">Áreas de Formación</p>
            </div>
            <div>
                <p class="text-2xl font-extrabold text-white">Presencial</p>
                <p class="text-xs font-medium text-slate-200">Constancia en PDF</p>
            </div>
        </div>
    </div>
</section>

<!-- Betowa Category Filter Bar -->
<section aria-label="Filtrar por área de formación" class="mb-8">
    <div class="bg-white rounded-xl border border-slate-200 p-3.5 shadow-xs flex items-center gap-2 overflow-x-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-[#00324D] px-2 shrink-0">Áreas:</span>
        <button type="button" onclick="setSpecialtyFilter('ALL', this)"
                class="specialty-pill shrink-0 text-xs font-bold px-4 py-2 rounded-lg bg-[#39A900] text-white transition">
            Todos los talleres (@Model.Workshops.Count)
        </button>
        @foreach (var spec in specialties)
        {
            <button type="button" onclick="setSpecialtyFilter('@spec', this)"
                    class="specialty-pill shrink-0 text-xs font-semibold px-4 py-2 rounded-lg bg-slate-100 text-[#00324D] hover:bg-[#EBF7E5] hover:text-[#2D8600] transition">
                @spec
            </button>
        }
    </div>
</section>

<!-- Betowa Course Cards Grid -->
<section aria-label="Listado de talleres disponibles">
    @if (Model.Workshops.Count == 0)
    {
        <div class="rounded-2xl bg-white border border-slate-200 p-12 text-center shadow-xs">
            <p class="text-lg font-bold text-[#00324D] mb-1">No hay talleres futuros programados</p>
            <p class="text-sm text-slate-500">Pronto se habilitarán nuevas convocatorias.</p>
        </div>
    }
    else
    {
        <div id="workshopsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var workshop in Model.Workshops)
            {
                var isEnrolled = Model.ActiveEnrolledWorkshopIds.Contains(workshop.Id);
                var hasSpots = workshop.AvailableSpots > 0;
                var occupancyPercent = workshop.MaxCapacity > 0
                    ? Math.Min(100, (int)Math.Round((double)workshop.ActiveEnrollmentsCount / workshop.MaxCapacity * 100))
                    : 0;

                <article data-specialty="@workshop.InstructorSpecialty"
                         data-search="@($"{workshop.Code} {workshop.Title} {workshop.Description} {workshop.InstructorName} {workshop.InstructorSpecialty}".ToLowerInvariant())"
                         class="workshop-card bg-white rounded-xl border border-slate-200 shadow-xs hover:shadow-lg transition-all duration-200 flex flex-col justify-between overflow-hidden">

                    <!-- Betowa Card Header Band -->
                    <div>
                        <div class="bg-[#00324D] px-5 py-3 flex items-center justify-between">
                            <span class="text-xs font-extrabold tracking-wider uppercase px-2.5 py-0.5 rounded bg-[#39A900] text-white">
                                @workshop.Code
                            </span>
                            <span class="text-xs font-semibold text-slate-200">
                                @workshop.InstructorSpecialty
                            </span>
                        </div>

                        <div class="p-6">
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-[#2D8600] bg-[#EBF7E5] px-2.5 py-0.5 rounded">
                                    ● Presencial
                                </span>

                                @if (isEnrolled)
                                {
                                    <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-[#EBF7E5] text-[#2D8600] border border-[#39A900]/40">
                                        ✓ Ya inscrito
                                    </span>
                                }
                            </div>

                            <h2 class="text-lg font-extrabold text-[#00324D] hover:text-[#39A900] transition mb-2 line-clamp-1">
                                <a asp-controller="Workshops" asp-action="Details" asp-route-id="@workshop.Id">
                                    @workshop.Title
                                </a>
                            </h2>
                            <p class="text-sm text-slate-600 leading-relaxed mb-4 line-clamp-2">@workshop.Description</p>

                            <div class="space-y-2 text-xs text-slate-700 bg-slate-50 p-3.5 rounded-lg border border-slate-200/70 mb-4">
                                <div class="flex justify-between">
                                    <span class="font-semibold text-slate-500">Instructor:</span>
                                    <span class="font-bold text-[#00324D]">@workshop.InstructorName</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="font-semibold text-slate-500">Fecha:</span>
                                    <span class="font-bold text-slate-800">@workshop.StartDate.ToString("yyyy-MM-dd")</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="font-semibold text-slate-500">Horario:</span>
                                    <span class="font-semibold text-slate-800">@workshop.StartDate.ToString("HH:mm") a @workshop.EndDate.ToString("HH:mm") UTC</span>
                                </div>
                            </div>

                            <div>
                                <div class="flex justify-between items-center text-xs mb-1.5">
                                    <span class="font-semibold text-slate-600">Cupos disponibles:</span>
                                    <span class="font-extrabold @(hasSpots ? "text-[#2D8600]" : "text-rose-600")">
                                        @workshop.AvailableSpots de @workshop.MaxCapacity libres
                                    </span>
                                </div>
                                <div class="w-full h-2 rounded-full bg-slate-200 overflow-hidden">
                                    <div class="h-full rounded-full @(hasSpots ? "bg-[#39A900]" : "bg-rose-600")" style="width: @(Math.Max(10, occupancyPercent))%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-200/80 flex items-center justify-between gap-3">
                        <a asp-controller="Workshops" asp-action="Details" asp-route-id="@workshop.Id"
                           class="text-xs font-bold text-[#00324D] hover:text-[#39A900] transition">
                            Ver detalle →
                        </a>

                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Participant"))
                        {
                            @if (isEnrolled)
                            {
                                <a asp-controller="Enrollments" asp-action="Mine"
                                   class="text-xs font-bold px-4 py-2 rounded-lg bg-[#00324D] text-white hover:bg-[#002235] transition">
                                    Ir a mis talleres
                                </a>
                            }
                            else if (hasSpots)
                            {
                                <form asp-controller="Enrollments" asp-action="Create" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="workshopId" value="@workshop.Id" />
                                    <button type="submit"
                                            class="text-xs font-bold px-4 py-2 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] shadow-xs transition">
                                        Inscribirse
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-xs font-bold px-3 py-1.5 rounded-lg bg-rose-100 text-rose-700">Cupo lleno</span>
                            }
                        }
                        else if (User.Identity?.IsAuthenticated != true && hasSpots)
                        {
                            <a asp-controller="Account" asp-action="Login"
                               class="text-xs font-bold px-4 py-2 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] transition">
                                Inscribirse
                            </a>
                        }
                    </div>
                </article>
            }
        </div>

        <!-- Empty Search / Filter State -->
        <div id="noSearchResults" class="hidden rounded-2xl bg-white border border-slate-200 p-12 text-center shadow-xs mt-4">
            <div class="w-12 h-12 rounded-xl bg-[#EBF7E5] text-[#2D8600] flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <p class="text-lg font-extrabold text-[#00324D] mb-1">No se encontraron talleres con ese criterio</p>
            <p class="text-sm text-slate-500 mb-5">Intenta con otra palabra clave o selecciona todas las áreas de formación.</p>
            <button type="button" onclick="resetWorkshopFilters()"
                    class="text-xs font-bold px-5 py-2.5 rounded-lg bg-[#39A900] text-white hover:bg-[#2D8600] transition">
                Limpiar búsqueda y filtros
            </button>
        </div>
    }
</section>

@section Scripts {
    <script>
        let currentSpecialty = 'ALL';

        function setSpecialtyFilter(specialty, btn) {
            currentSpecialty = specialty;
            document.querySelectorAll('.specialty-pill').forEach(el => {
                el.classList.remove('bg-[#39A900]', 'text-white', 'font-bold');
                el.classList.add('bg-slate-100', 'text-[#00324D]', 'font-semibold');
            });
            btn.classList.remove('bg-slate-100', 'text-[#00324D]', 'font-semibold');
            btn.classList.add('bg-[#39A900]', 'text-white', 'font-bold');
            filterWorkshops();
        }

        function filterWorkshops() {
            const query = (document.getElementById('workshopSearch')?.value || '').toLowerCase().trim();
            let visibleCount = 0;

            document.querySelectorAll('.workshop-card').forEach(card => {
                const spec = card.getAttribute('data-specialty') || '';
                const text = card.getAttribute('data-search') || '';
                const matchesSpec = currentSpecialty === 'ALL' || spec === currentSpecialty;
                const matchesText = !query || text.includes(query);
                const isVisible = matchesSpec && matchesText;
                card.style.display = isVisible ? '' : 'none';
                if (isVisible) visibleCount++;
            });

            const emptyState = document.getElementById('noSearchResults');
            if (emptyState) {
                emptyState.classList.toggle('hidden', visibleCount > 0);
            }
        }

        function resetWorkshopFilters() {
            const searchInput = document.getElementById('workshopSearch');
            if (searchInput) searchInput.value = '';
            const firstPill = document.querySelector('.specialty-pill');
            if (firstPill) setSpecialtyFilter('ALL', firstPill);
        }
    </script>
}
